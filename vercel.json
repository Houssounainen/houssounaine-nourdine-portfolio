{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/association",
      "destination": "/classique/association",
      "permanent": false
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v2/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/projets",
      "destination": "/#projets",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/expertise",
      "destination": "/"
    },
    {
      "source": "/journey",
      "destination": "/"
    },
    {
      "source": "/projects",
      "destination": "/"
    },
    {
      "source": "/works",
      "destination": "/"
    },
    {
      "source": "/clients",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/classique/:route(expertise|journey|projects|works|clients|association|contact)",
      "destination": "/classique"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh"
}
